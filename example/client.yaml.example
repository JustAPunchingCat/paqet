# paqet Client Configuration Example

# Role must be explicitly set
role: "client"

# Logging configuration
log:
  level: "info"  # none, debug, info, warn, error, fatal

# Network interface settings
network:
  interface: "en0"                          # CHANGE ME: Network interface (en0, eth0, wlan0, etc.)
  driver: "ebpf"    # Driver: "pcap" (default), "afpacket" (Linux only, faster), "ebpf" (Linux XDP, fastest),"ebpf-generic"
  # guid: "\Device\NPF_{...}"               # Windows only (Npcap).

  # IPv4 configuration
  ipv4:
    addr: "192.168.1.100:0"                 # CHANGE ME: Local IP (use port 0 for random port)
    router_mac: "aa:bb:cc:dd:ee:ff"         # CHANGE ME: Gateway/router MAC address

  # IPv6 configuration (optional)
  ipv6:
    addr: "[2001:db8::1]:0"                 # CHANGE ME: Local IPv6 address and port (optional)
    router_mac: "aa:bb:cc:dd:ee:ff"         # CHANGE ME: Gateway/router MAC address for IPv6

  # Source IP Spoofing (optional)
  spoof:
    enabled: false
    # Define servers and their spoofing rules
    servers:
      - name: "primary-upstream"
        real_server_ips: ["198.51.100.1"]
        spoofed_server_ips: ["192.0.2.0/24", "198.51.100.2"]
        # Optional: Map this server to a dedicated list of client source IPs.
        # The client will pretend to be one of these IPs when connecting to this server.
        # Note: The server MUST map these IPs in its 'clients' list!
        spoofing_client_ips: ["10.100.0.0/24"]

      - name: "backup-upstream"
        real_server_ips: ["203.0.113.4", "203.0.113.5"]
        spoofed_server_ips: ["10.2.0.0/16"]

  tcp:
    local_flag: ["PA"]                      # Local TCP flags (Push+Ack default)
    remote_flag: ["PA"]                     # Remote TCP flags (Push+Ack default)
    
    # Reverse tunnel flags
    # local_flag: ["SA"]
    # remote_flag: ["S"]

  # PCAP/AF_PACKET settings (optional - will use defaults)
  # pcap:
    # sockbuf: 4194304                        # 4MB buffer (default for client)



# Servers configuration
# Define multiple servers, each with its own SOCKS5 and forwarding rules.
servers:
  - enabled: true               # Enable/Disable this server (default: true)
    server:
      addr: "10.0.0.100:9999"   # CHANGE ME: First server address
                                # NOTE: If hopping is enabled, this port is ignored for transport
                                # and the hopping range is used instead.
    
    # Fake TCP Handshake Configuration (Optional)
    # Satisfies strict DPI/Netfilter middleboxes that drop flows without a
    # proper SYN exchange. Server-dependent: each remote server below enables
    # it independently. Works with or without port hopping.
    handshake:
      enabled: false   # Enable the fake 3-way handshake (default: false)
      mode: lazy       # "lazy" (default): handshake on first data; "eager": pre-warm ahead of hop
      eager_time: 3    # Eager-mode lead time in seconds (default: 3, only used when mode: eager)

    # Port Hopping Configuration (Optional)
    # Periodically changes the destination port to evade detection on fixed ports.
    # The server must be configured with the same range.
    hopping:
      enabled: false            # Enable port hopping
      interval: 180             # Interval in seconds to change ports (default: 180-300).
                                # NOTE: middleboxes throttle the server->client
                                # return path of a fresh NAT mapping for the
                                # first ~10s; hop intervals well above that
                                # (>=60) keep each hop's blackout brief.
      rotate_client_port: false # Rebind the CLIENT's local source port on every
                                # hop (see rotate_every). Creates a fresh NAT
                                # mapping with a fresh return-path quota —
                                # defeats middleboxes that blackhole the
                                # return path of a matured mapping. Requires
                                # an eBPF capture source; pcap/afpacket builds
                                # log once and continue with server-port
                                # hopping only. Recommended: true when hopping
                                # is enabled.
      rotate_every: 1           # Client-port rotation cadence in hops (default 1).
                                # 1 = rotate every hop (strongest, 1 extra
                                # SYN per hop); 3 = rotate every 3rd hop.
      ports:                    # List of single ports or ranges
        - "80"
        - "20000-45000"   # Recommended: 20000-45000

    # Obfuscation Configuration (Optional)
    obfuscation:
      use_tls: true       # Wraps traffic in TLS Application Data (0x17)
      padding:
        enabled: true    # Enable random padding
        min: 32           # Minimum padding bytes
        max: 64           # Maximum padding bytes
      headers:
        randomize_tos: false      # Turn off to act like a standard OS
        randomize_ttl: false      # Turn off to prevent 'packet crafting' signatures
        randomize_window: true

    socks5:
      - listen: "127.0.0.1:1080"
        username: ""
        password: ""
        # sockbuf: 4194304        # UDP socket buffer size (default: 4MB). Reduce to 1048576 (1MB) for low-RAM devices.
    # forward:
    #   - listen: "127.0.0.1:8080"
    #     target: "127.0.0.1:80"
    #     protocol: "tcp"
    #     unordered: true       # Disable reordering for UDP (default: true)
    #     sockbuf: 67108864     # Socket buffer size for the local forwarder (default: 4194304)
                                # Requires corresponding net.core.rmem_max/wmem_max sysctl increases on Linux.
    # Transport protocol configuration for this server
    transport:
      protocol: "kcp"  # Transport protocol: "kcp", "quic", "udp", or "auto"
                       # "auto" mode: client probes all configured protocols
                       # and selects the one with lowest RTT.
                       # Requires at least 2 protocol sections configured.
                       # Server must also use "auto" to accept all protocols.
      conn: 4          # Number of connections (1-256, default: 4, power-of-2 recommended)
      
      # tcpbuf: 8192   # TCP buffer size in bytes
      # udpbuf: 4096   # UDP buffer size in bytes

      # KCP protocol settings
      kcp:
        mode: "fast"              # KCP mode: normal, fast, fast2, fast3, manual
                                  # - normal: nodelay=0, interval=40, resend=2, nocongestion=1
                                  # - fast:   nodelay=1, interval=30, resend=2, nocongestion=1
                                  # - fast2:  nodelay=1, interval=20, resend=2, nocongestion=1
                                  # - fast3:  nodelay=1, interval=10, resend=2, nocongestion=1
                                  # - manual: use parameters below

        # Manual mode parameters (only used when mode="manual")
        # nodelay: 1              # 0=disable, 1=enable
                                  # Enable for lower latency & aggressive retransmission
                                  # Disable for TCP-like conservative behavior
                      
        # interval: 10            # Internal update timer interval in milliseconds (10-5000ms)
                                  # Lower values increase responsiveness but raise CPU usage

        # resend: 2               # Fast retransmit trigger (0-2)
                                  # 0 = disabled (wait for timeout only)
                                  # 1 = most aggressive (retransmit after 1 ACK skip)
                                  # 2 = aggressive (retransmit after 2 ACK skips)

        # nocongestion: 1         # Congestion control: 0=enabled, 1=disabled
                                  # 0 = TCP-like fair congestion control (slow start, congestion avoidance)
                                  # 1 = disable congestion control for maximum speed

        # wdelay: false           # Write batching behavior
                                  # false = flush immediately (low latency, recommended for real-time)
                                  # true = batch writes until next update interval (higher throughput)
                                  # Controls when data is actually sent to the network

        # acknodelay: true        # ACK sending behavior
                                  # true = send ACKs immediately when packets are received (lower latency)
                                  # false = batch ACKs (more bandwidth efficient)
                                  # Setting true reduces latency but increases bandwidth usage

        # Window & MTU settings (Applies to ALL modes)
        # mtu: 0                 # Maximum transmission unit (0=auto PMTUD, 50-1500). Default 1280.
        # rcvwnd: 2048           # Receive window size (default: 2048)
        # sndwnd: 2048           # Send window size (default: 2048)

        # Encryption settings
        # block: "aes"                    # Encryption: aes, aes-128, aes-128-gcm, aes-192, salsa20, blowfish, twofish, cast5, 3des, tea, xtea, xor, sm4, none, null.
        key: "your-secret-key-here"       # CHANGE ME: Secret key (must match server)

        # Buffer settings (optional)
        # smuxbuf: 4194304       # 4MB session buffer (default). Increase for 1Gbps+, decrease to 2097152 for low-RAM.
        # streambuf: 262144      # 256KB per-stream buffer (default). Increase for max speed, decrease to 65536 for low-RAM.

        # Optional Forward Error Correction (FEC) - currently disabled
        # Use these only if you need FEC for very lossy networks:
        # dshard: 10    # Data shards for FEC
        # pshard: 3     # Parity shards for FEC

        # Liveness / dead-peer detection
        # deadlink: 120          # Seconds of silence before the peer is declared dead (default: 120).
                                # Detects a crashed/killed peer and tears the session down instead of
                                # retransmitting forever. Raise it for high-latency/lossy links, or set
                                # -1 to disable the keepalive entirely (no false kills; goodbye-RST
                                # still covers clean shutdowns).

      # QUIC protocol settings (used when protocol: "quic")
      # quic:
      #   key: "your-secret-key-here"   # Shared secret for deterministic TLS cert (must match server)
      #   alpn: "h3"                    # ALPN protocol (default: "h3" to mimic HTTP/3)
      #   max_streams: 256              # Max concurrent streams (1-65535)
      #   idle_timeout: 30s             # Connection idle timeout (1s-5m)
      #   # cert_file: "cert.pem"      # Optional: custom TLS certificate
      #   # key_file: "key.pem"        # Optional: custom TLS private key

      # UDP protocol settings (used when protocol: "udp")
      # WARNING: No reliability layer - packet loss causes stream errors
      # udp:
      #   key: "your-secret-key-here"   # Encryption key (must match server)
      #   block: "aes"                  # Encryption: aes, salsa20, none, etc.
      #   mtu: 0                        # Maximum transmission unit (0=auto PMTUD, 50-1500). Default 1280.

  # - enabled: false
  #   server:
  #     addr: "10.0.0.101:9999"    # Second server
  #   socks5:
  #     - listen: "127.0.0.1:1081" # CHANGE ME: Must be different from the first server's SOCKS port!
  #   transport: ...